// Gaurav Nursery — Specialized Multi-Vendor Plant Marketplace
// Database Schema configured for SQLite (Development) and PostgreSQL-ready conventions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// --------------------------------------------------------
// 1. AUTHENTICATION & ROLE-BASED ACCESS CONTROL (RBAC)
// --------------------------------------------------------
// Roles: SUPER_ADMIN, SELLER, CUSTOMER, DELIVERY_PARTNER
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("CUSTOMER") // "SUPER_ADMIN", "SELLER", "CUSTOMER", "DELIVERY_PARTNER"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  sellerProfile    SellerProfile?
  orders           Order[]           @relation("CustomerOrders")
  assignedDelivery SubOrder[]        @relation("DeliveryPartnerSubOrders")
  notifications    Notification[]
  auditLogs        AuditLog[]        @relation("ActorAuditLogs")
  reviews          Review[]          @relation("CustomerReviews")
  wishlistItems    Wishlist[]        @relation("CustomerWishlist")
}

// --------------------------------------------------------
// 2. SELLER ONBOARDING & APPROVAL WORKFLOW
// Statuses: REGISTERED -> KYC_PENDING -> APPROVED / REJECTED -> ACTIVE, SUSPENDED
// --------------------------------------------------------
model SellerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName       String   // e.g. "Gaurav Greenery Hub"
  slug               String?  @unique // e.g. "gaurav-greenery-hub" for public storefront
  bio                String?
  nurseryAddress     String
  city               String
  state              String
  pincode            String
  
  panNumber          String?
  gstNumber          String?
  idProofUrl         String?
  nurseryPhotos      String   @default("[]") // JSON string of photo URLs
  
  bankName           String?
  accountNumber      String?
  ifscCode           String?
  accountHolderName  String?
  upiId              String?

  status             String   @default("REGISTERED") // "REGISTERED", "KYC_PENDING", "APPROVED", "REJECTED", "ACTIVE", "SUSPENDED"
  rejectionReason    String?
  commissionRate     Float    @default(0.10) // 10% platform fee
  rating             Float    @default(4.8)
  totalSalesCount    Int      @default(0)
  
  availableBalance   Float    @default(0.0)
  totalEarned        Float    @default(0.0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products           Product[]
  subOrders          SubOrder[]
  commissionLedgers  CommissionLedger[]
  payouts            SellerPayout[]
}

// --------------------------------------------------------
// 3. CATEGORIES & SPECIALIZED PLANT CATALOG
// Product Status: DRAFT -> PENDING_REVIEW -> APPROVED -> LIVE, OUT_OF_STOCK
// --------------------------------------------------------
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id               String   @id @default(uuid())
  sellerId         String
  seller           SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  
  title            String
  slug             String   @unique
  description      String
  sku              String   @unique
  price            Float
  mrp              Float
  stock            Int      @default(10)
  images           String   @default("[]") // JSON array of image URLs
  
  // Specialized Nursery & Plant Attributes
  sunlight         String   @default("Moderate") // "Low Light (Indoor)", "Moderate", "Full Sun (Outdoor)"
  waterRequirement String   @default("Moderate") // "Low (Once a week)", "Moderate (2-3 days)", "High (Daily)"
  plantHeight      String?  // e.g. "10 - 14 inches"
  potSize          String?  // e.g. "6 inch nursery pot"
  soilType         String?  // e.g. "Well-draining potting soil with perlite"
  difficulty       String   @default("Beginner Friendly") // "Beginner Friendly", "Intermediate", "Expert"
  plantType        String?  // "Air Purifying", "Flowering", "Bonsai", "Foliage", "Fruit", "Herb"
  careTips         String?  // Rich care instructions

  // Approval Pipeline
  status           String   @default("DRAFT") // "DRAFT", "PENDING_REVIEW", "APPROVED", "REJECTED", "LIVE", "OUT_OF_STOCK"
  rejectionReason  String?
  featured         Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems       OrderItem[]
  reviews          Review[]
  wishlistItems    Wishlist[]
}

// --------------------------------------------------------
// 4. MULTI-VENDOR ORDER SPLITTING
// Master Order -> Sub Orders (per seller) -> Order Items
// --------------------------------------------------------
model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique // e.g. "GN-2026-1001"
  customerId       String
  customer         User        @relation("CustomerOrders", fields: [customerId], references: [id])
  
  customerName     String
  customerEmail    String
  customerPhone    String
  shippingAddress  String
  shippingCity     String
  shippingState    String
  shippingPincode  String

  totalGrossAmount Float       // Sum of all items
  totalPlatformFee Float       // 10% platform commission total
  totalSellerNet   Float       // 90% total payable to sellers

  paymentMethod    String      @default("TEST_PAYMENT") // "TEST_PAYMENT", "COD", "UPI", "CARD"
  paymentStatus    String      @default("PAID") // "PENDING", "PAID", "FAILED"
  masterStatus     String      @default("PLACED") // "PLACED", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  subOrders        SubOrder[]
}

model SubOrder {
  id                 String            @id @default(uuid())
  subOrderNumber     String            @unique // e.g. "GN-2026-1001-A"
  
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  sellerId           String
  seller             SellerProfile     @relation(fields: [sellerId], references: [id])
  
  deliveryPartnerId  String?
  deliveryPartner    User?             @relation("DeliveryPartnerSubOrders", fields: [deliveryPartnerId], references: [id])

  grossAmount        Float             // Gross amount for this seller's products
  platformFee        Float             // 10% commission on this sub-order (frozen)
  sellerNet          Float             // 90% seller earnings (frozen)
  
  fulfillmentStatus  String            @default("PLACED") // "PLACED", "CONFIRMED", "PACKED", "SHIPPED", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED"
  trackingNumber     String?
  deliveryNotes      String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  items              OrderItem[]
  commissionLedger   CommissionLedger?
}

model OrderItem {
  id               String   @id @default(uuid())
  subOrderId       String
  subOrder         SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  
  productTitle     String
  productImage     String?
  unitPrice        Float
  quantity         Int
  lineTotal        Float    // unitPrice * quantity
  
  commissionRate   Float    @default(0.10)
  commissionAmount Float    // lineTotal * 0.10 (frozen)
  sellerEarning    Float    // lineTotal * 0.90 (frozen)

  createdAt        DateTime @default(now())
}

// --------------------------------------------------------
// 5. 10% COMMISSION IMMUTABLE FINANCIAL LEDGER & AUDIT TRAIL
// --------------------------------------------------------
model CommissionLedger {
  id               String        @id @default(uuid())
  subOrderId       String        @unique
  subOrder         SubOrder      @relation(fields: [subOrderId], references: [id])
  
  sellerId         String
  seller           SellerProfile @relation(fields: [sellerId], references: [id])

  orderAmount      Float         // e.g. 1000.0 (frozen)
  commissionRate   Float         @default(0.10) // e.g. 0.10 (frozen)
  platformFee      Float         // e.g. 100.0 (frozen)
  sellerGross      Float         // e.g. 900.0 (frozen)
  refundAmount     Float         @default(0.0)
  sellerPayable    Float         // e.g. 900.0 - refund
  
  settlementStatus String        @default("PENDING_DELIVERY") // "PENDING_DELIVERY", "ELIGIBLE_FOR_PAYOUT", "PAYOUT_REQUESTED", "SETTLED"
  payoutId         String?
  payout           SellerPayout? @relation(fields: [payoutId], references: [id])

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model SellerPayout {
  id               String             @id @default(uuid())
  payoutNumber     String             @unique // e.g. "PAY-2026-0001"
  sellerId         String
  seller           SellerProfile      @relation(fields: [sellerId], references: [id])

  amount           Float
  status           String             @default("REQUESTED") // "REQUESTED", "APPROVED", "PROCESSED", "REJECTED"
  
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  utrReference     String?            // Bank UTR or Transaction reference
  adminNotes       String?

  requestedAt      DateTime           @default(now())
  processedAt      DateTime?

  ledgers          CommissionLedger[]
}

// --------------------------------------------------------
// 6. PHASE 1.5 ADDITIONS: COUPONS, BANNERS, REVIEWS, WISHLIST
// --------------------------------------------------------
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. "MONSOON10", "WELCOME50"
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE", "FLAT"
  discountValue  Float     // e.g. 10.0 for 10% or 100.0 for ₹100 flat
  minOrderAmount Float     @default(0.0)
  maxDiscount    Float?    // Cap for percentage discounts
  validUntil     DateTime?
  isActive       Boolean   @default(true)
  usageCount     Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Banner {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  imageUrl     String
  linkUrl      String   @default("/shop")
  badgeText    String?  // e.g. "SEASONAL SPECIAL", "NEW ARRIVALS"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  customerId         String
  customer           User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)

  rating             Int      @default(5) // 1 to 5 stars
  comment            String
  isVerifiedPurchase Boolean  @default(true)

  createdAt          DateTime @default(now())
}

model Wishlist {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation("CustomerWishlist", fields: [customerId], references: [id], onDelete: Cascade)
  
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// --------------------------------------------------------
// 7. AUDIT LOGS & NOTIFICATIONS
// --------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action      String   // e.g. "SELLER_SUSPENDED", "BULK_PRODUCTS_APPROVED", "COUPON_CREATED"
  entityType  String   // "SELLER", "PRODUCT", "ORDER", "PAYOUT", "COUPON", "BANNER"
  entityId    String?
  metadata    String?  // JSON string
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
